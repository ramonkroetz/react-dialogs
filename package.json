{
  "name": "react-dialogs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./styles.css": "./lib/react-dialogs.css"
  },
  "type": "module",
  "scripts": {
    "build": "npm run build:lib && npm run build:dist",
    "build:dist": "vite build --mode app",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview --outDir dist --open",
    "dev": "vite --open",
    "format": "biome check --write .",
    "lint": "npm run lint:biome && npm run lint:ts",
    "lint:biome": "biome lint --error-on-warnings . && biome check .",
    "lint:ts": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "opencode": "npm exec opencode -- .",
    "commit": "npm exec opencode -- run --command commit"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@microsoft/api-extractor": "7.58.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "happy-dom": "20.10.4",
    "opencode-ai": "1.18.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.2",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "1.4.0",
    "motion": "12.23.24",
    "react-remove-scroll": "2.7.1"
  },
  "allowScripts": {
    "opencode-ai@1.18.8": true
  }
}
